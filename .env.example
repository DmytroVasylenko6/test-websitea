# Local origin for canonical URLs, sitemap and Open Graph.
# Production builds ignore localhost, *.onrender.com and *.vercel.app and fall
# back to https://web.legal-inform-service.com.ua. Another https origin is used as-is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public mailbox. Leave empty or example.com to hide email in the UI.
CONTACT_EMAIL=

# Telegram bot that posts lead forms into a channel or group.
# Create a bot via @BotFather, add it to the channel, then paste values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
